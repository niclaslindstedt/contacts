{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contacts",
  "mainBinaryName": "contacts",
  "version": "../../package.json",
  "identifier": "dev.local.contacts",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../webroot": "webroot"
    },
    "category": "Productivity",
    "shortDescription": "a local-first address book",
    "longDescription": "A local-first address book: folders, namespaces, photos, optional encryption, and export to vCard and CSV for Outlook, iOS and Android. Your contacts stay on your machine.",
    "copyright": "Copyright © Niclas Lindstedt",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
